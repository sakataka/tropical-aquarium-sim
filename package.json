{
  "name": "tropical-aquarium-sim",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "packageManager": "bun@1.4.3",
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "build": "bun run typecheck && bun run scripts/build-frontend.ts",
    "preview": "bun run scripts/dev-frontend.ts --preview",
    "test": "bun run scripts/test.ts all",
    "test:fast": "bun run scripts/test.ts fast",
    "test:tanks": "bun run scripts/test.ts tanks",
    "test:fuzz": "TEST_SEED=random bun run scripts/test.ts all",
    "verify:webview": "bun run scripts/verify-webview.ts",
    "measure:perf": "bun run scripts/measure-performance.ts",
    "compare:render": "bun run scripts/compare-render.ts",
    "plan:check": "bun run scripts/check-exhibit-plan.ts",
    "typecheck": "bun check --threads=4"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "pixi.js": "^8.22.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "@types/bun": "^1.4.2"
  }
}
