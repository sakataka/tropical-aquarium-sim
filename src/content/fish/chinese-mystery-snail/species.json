{
  "id": "chinese-mystery-snail",
  "displayName": "チャイニーズミステリースネール",
  "realBodyLengthCm": 8.5,
  "catalog": {
    "scientificName": "Margarya chinensis",
    "originRegionId": "east-asia",
    "originRegionName": "東アジア",
    "origin": "中国、台湾、韓国、日本が原産とされます（2014年の論文の整理による）。中国では広西、雲南、四川、広東、吉林などの標本が調べられています。北アメリカやヨーロッパの一部には、持ち込まれて定着しています。",
    "temperament": "歯舌で底や石の表面の珪藻を削って食べるほか、呼吸する水から細かな粒をこし取って食べます。本水槽では、砂利の底や石の上をゆっくり這い、ときどき立ち止まって底を削ります。",
    "movement": "大きな足で底を這います。本水槽では、殻を背負ったまま頭と足を伸び縮みさせて進み、触角を揺らします。叩かれると頭と足を殻に引っ込め、しばらくしてから這い出します。",
    "habitat": "湖、池、灌漑の水路、溝、流れのゆるい川の、砂から泥の底にすみます。アメリカの池では、金魚と同じ網で採集された記録があります。本水槽では、金魚の泳ぐ明るい砂利の底を這います。",
    "aliases": [
      "Chinese mystery snail",
      "Cipangopaludina chinensis",
      "Bellamya chinensis"
    ]
  },
  "profile": {
    "taxonomy": {
      "order": "Architaenioglossa",
      "orderJa": "タニシ目",
      "family": "Viviparidae",
      "familyJa": "タニシ科"
    },
    "adultSizeCm": 5,
    "sizeNote": "殻高での値で、最大70mmになるとされます。濾過の実験では殻高30〜60mmの個体が使われました。画面では、殻高約5cm、触角を含めた幅約8.5cmの成体の雌として描いています。",
    "distribution": "中国、台湾、韓国、日本が原産とされます。北アメリカやヨーロッパの一部に移入しています。",
    "water": {
      "salinity": "freshwater"
    },
    "keeping": "home",
    "conservation": {
      "note": "IUCN レッドリストの区分は、今回の調査では確かめられていません。北アメリカなどでは移入生物として研究されています。"
    },
    "highlights": [
      "雌は体の中の育房で胚を育て、稚貝を産みます（解剖した雌の育房に約45〜84の胚があった例があります）。",
      "底をなぞって食べるのと、水をこして粒を食べるのと、2つの食べ方をします。",
      "金魚と一緒に飼った実験では、稚貝の総重量が増え、金魚がやや小さく育ちました。",
      "2026年の分類の見直しで、Cipangopaludina から Margarya の属に移されました。"
    ]
  },
