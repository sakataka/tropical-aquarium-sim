  "catalog": {
    "scientificName": "Labidochromis chisumulae",
    "originRegionId": "east-africa",
    "originRegionName": "東アフリカ",
    "origin": "マラウイ湖のチズムル島の岩場にだけすむとされる小型のシクリッド。雄は白から淡い青の体に、濃い青黒の縦縞が入ります。",
    "temperament": "群れを作らず、1尾ずつ行動するとされます。決まった縄張りは持たないものの、餌場から同じ種を追い払います。飼育下では、雄が雌を追い回すことがあります。",
    "movement": "岩のそばを短く泳いで餌場を移り、岩の表面や隙間から小さな無脊椎動物をついばみます。",
    "habitat": "堆積物の積もった岩場。水深3〜20mの記録があります。",
    "aliases": [
      "Chisumulu cichlid",
      "Chizumulu cichlid",
      "ラビドクロミス・チスムラエ",
      "キスムラエ"
    ]
  },
  "profile": {
    "taxonomy": {
      "order": "Cichliformes",
      "orderJa": "シクリッド目",
      "family": "Cichlidae",
      "familyJa": "シクリッド科"
    },
    "adultSizeCm": 6.6,
    "sizeNote": "FishBase の最大は標準体長6.6cmです。雄の模式標本は標準体長5.57cmでした。産地の解説では、雄は全長8cm、雌は6cmほどまでとされます。典型的な大きさは確かめられていません。",
    "distribution": "マラウイ湖のチズムル島（Chizumulu Island）に限られるとされます。模式産地も同じ島の沖です。",
    "water": {
      "salinity": "freshwater"
    },
    "keeping": "home",
    "conservation": {
      "status": "LC",
      "assessedYear": 2018,
      "note": "IUCN の2019年の報告書で LC を確認しました。評価年は FishBase の記載（2018年6月22日）です。"
    },
    "highlights": [
      "雄は白から淡い青の体に、濃い青黒の縦縞が入ります。縞の濃さや広がりは個体によって違います。",
      "背びれの付け根側に暗い帯があり、縁は淡い色です。目から口にかけて暗い帯が出る雄もいます。",
      "岩の表面の付着物や隙間から、小さな無脊椎動物をついばむとされます。",
      "雌は白っぽい体色です。飼育下では、雌が卵と稚魚を口の中で育てる様子が観察されています。"
    ]
  },
