  "catalog": {
    "scientificName": "Myripristis murdjan",
    "originRegionId": "indo-pacific",
    "originRegionName": "インド太平洋",
    "origin": "紅海と東アフリカから西太平洋・中部太平洋まで分布し、北は日本の南部、南はオーストラリアまで見られます。2023年には高知市の春野漁港でも採集されました。",
    "temperament": "夜に活動する魚です。単独でいることも群れることもあり、昼は洞窟の天井近くに集まっていることがあります。",
    "movement": "昼は洞窟や岩棚の張り出しの下にとどまり、底近くの水中に浮かんでいます。夜になると隠れ場所から出て、大型の動物プランクトンや甲殻類の幼生などを食べます。",
    "habitat": "サンゴ礁の礁原や浅い礁湖、外側の礁に暮らし、岩棚や洞窟、割れ目を利用します。おもに水深1〜50mで見られ、160mの記録もあります。",
    "aliases": [
      "Crimson soldierfish",
      "Pinecone soldierfish"
    ]
  },
  "profile": {
    "taxonomy": {
      "order": "Holocentriformes",
      "orderJa": "イットウダイ目",
      "family": "Holocentridae",
      "familyJa": "イットウダイ科"
    },
    "adultSizeCm": 18,
    "sizeNote": "全長18cmほどにふつうに達します。最大全長は資料によって23cm、27cmと異なり、60cmとする記録もありますが、その根拠は確かめられていません。",
    "distribution": "紅海・東アフリカから西〜中部太平洋まで、日本の南部からオーストラリアにかけて分布します。高知県で2023年に採集された標本が、四国で確実な初めての記録として報告されています。",
    "water": {
      "salinity": "marine"
    },
    "keeping": "publicAquarium",
    "conservation": {
      "status": "LC",
      "assessedYear": 2015,
      "note": "キンメダイ目に分類する資料もあります。"
    },
    "highlights": [
      "大きな目と、縁が赤い大きな鱗が目立ちます。",
      "えらぶたの後ろから胸びれの付け根にかけて暗色の部分があり、背びれの後半、しりびれ、尾びれ、腹びれの前の縁が白く見えます。",
      "よく似たアカマツカサとは、背びれが赤く、下あごがあまり突き出ないことで見分けます。",
      "昼は岩陰でじっとしていて、夜になると隠れ場所から出て餌を探します。"
    ]
  },
