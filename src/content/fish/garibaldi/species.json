  "catalog": {
    "scientificName": "Hypsypops rubicundus",
    "originRegionId": "northeast-pacific",
    "originRegionName": "北東太平洋",
    "origin": "カリフォルニアのモントレー湾からバハ・カリフォルニア南部までの東太平洋に分布し、南カリフォルニアに多いスズメダイの仲間です。カリフォルニア州の州海水魚です。",
    "temperament": "成魚は隠れ穴と採餌場所を含む縄張りを一年中守り、同種やほかの魚を追い払います。本水槽では、岩場の隙間を住みかにして、近づく魚を追います。",
    "movement": "縄張りの岩の上で、海綿や藻類、管にすむゴカイ、コケムシなどをついばみます。求愛のときは、雄が輪を描くように泳いで雌を誘います。",
    "habitat": "水深30mほどまでの岩礁とケルプの森。本水槽では、ジャイアントケルプの根元に広がる岩礁をイメージしています。",
    "aliases": [
      "garibaldi",
      "garibaldi damselfish"
    ]
  },
  "profile": {
    "taxonomy": {
      "order": "Perciformes",
      "orderJa": "スズキ目",
      "family": "Pomacentridae",
      "familyJa": "スズメダイ科"
    },
    "adultSizeCm": 25,
    "sizeNote": "成魚の代表的な大きさは確かめられておらず、ここでは約25cmとして表示しています。最大で標準体長30cm、水族館の解説では約36cmとされます。南カリフォルニアの調査では雄のほうが大きく育ち、最高齢は57歳でした。",
    "distribution": "東太平洋のカリフォルニアからバハ・カリフォルニア南部に分布し、北はモントレー湾まで見られます。南カリフォルニアに多い魚です。",
    "water": {
