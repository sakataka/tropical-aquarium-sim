{
  "id": "horsehair-crab",
  "displayName": "ケガニ",
  "realBodyLengthCm": 15,
  "catalog": {
    "scientificName": "Erimacrus isenbeckii",
    "originRegionId": "northwest-pacific",
    "originRegionName": "北西太平洋",
    "origin": "北海道と本州の沿岸、朝鮮半島の沿岸で記録があります。最初に記載された標本は、アリューシャン列島のウナラスカ島のものです。",
    "temperament": "野外で何を食べているかは、ここでは確かめられていません。研究施設では、エビジャコ、キュウリウオ、スケトウダラ、アヤボラなどを与えて育てられました。活動時間や群れ方も分かっていません。本水槽では、1匹ずつ底を歩き回ります。",
    "movement": "海底を歩くカニで、横だけでなく前にも歩けます。本水槽では、泥砂底を横へ歩き、ときどき止まって、はさみで餌をつまんで口へ運びます。",
    "habitat": "砂や砂泥の海底にすみます。北海道では水温15℃以下の海にすむと紹介され、オホーツク海ではほぼ10℃以下で水深150mより浅いところにいます。岩手県の沖では主に水深150〜350mにすみ、冬から春に水温が下がると水深200mより浅いところへ移ります。本水槽では、冷たい海の泥砂底と岩をイメージしています。",
    "aliases": [
      "Horsehair crab",
      "Hair crab"
    ]
  },
  "profile": {
    "taxonomy": {
      "order": "Decapoda",
      "orderJa": "十脚目",
      "family": "Cheiragonidae",
      "familyJa": "クリガニ科"
    },
    "adultSizeCm": 8,
    "sizeNote": "甲長（甲の前後の長さ）での値です。代表的な成体の甲幅は確かめられておらず、北海道で雄をとってよい大きさの下限の甲長8cmを目安にしています。画面では脚を広げた幅（約15cm）で描いています。2025年の岩手県の調査でとれた個体は、雄が甲長3.6〜8.7cm、雌が3.5〜7.2cmでした。",
    "distribution": "北海道と本州の沿岸、朝鮮半島の沿岸で記録があります。分布の全体は、ここでは確かめられていません。",
    "water": {
      "salinity": "marine"
    },
    "keeping": "publicAquarium",
    "conservation": {
      "note": "世界の IUCN 区分は確かめられていません。北海道の2025年の資源管理マニュアルでは、雌と甲長8cm未満の雄をとることが禁じられています。岩手県の2025年の調査では、資源の水準は中位で増える傾向とされました。"
    },
    "highlights": [
      "甲と脚が短い剛毛に覆われ、甲の側縁に7つ、前縁に2つの歯が並びます。",
      "雄の甲は縦長の楕円形で、雌の甲は幅が広く円に近く、背中が強くふくらみます。",
      "雌は受精した卵を腹肢に付けて、ふ化するまで守ります。"
    ]
  },
