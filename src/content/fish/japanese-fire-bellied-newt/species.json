  "catalog": {
    "scientificName": "Cynops pyrrhogaster",
    "originRegionId": "japan",
    "originRegionName": "日本",
    "origin": "日本だけにすむイモリです。本州・四国・九州とその周りの島に分布します。八丈島の個体群は、人が持ち込んだものです。",
    "temperament": "夜に活発になります。成熟すると水中にとどまる傾向があり、4〜7月と秋に求愛します。強い神経毒を持つとされます。",
    "movement": "4本の脚で水底を歩き、強く左右に平たい尾で泳ぎます。本水槽では、ときどき水面へ泳ぎ上がって息を吸います。",
    "habitat": "水田・池・小川・溝など、おもに流れのない淡水にすみます。変態してから成熟するまでは陸で暮らします。ミミズや昆虫、カエルの幼生などの小動物を食べます。本水槽では、稲の切り株が残る田んぼの水路の底を歩きます。",
    "aliases": [
      "ニホンイモリ",
      "Japanese fire-bellied newt"
    ]
  },
  "profile": {
    "taxonomy": {
      "order": "Caudata",
      "orderJa": "有尾目",
      "family": "Salamandridae",
      "familyJa": "イモリ科"
    },
    "adultSizeCm": 10,
    "sizeNote": "全長は雄で7〜11cm、雌で8〜14cm（頭胴長は雄で4〜6cm、雌で4.5〜7.5cm）とされます。画面では全長約10cmで描いています。",
    "distribution": "日本固有。本州・四国・九州と周辺の島に分布します。地域によって系統が分かれ、別の種に分ける案もありますが、ここでは広い意味のアカハライモリとして扱います。",
    "water": {
      "salinity": "freshwater"
    },
    "keeping": "home",
    "conservation": {
      "note": "環境省レッドリスト（2026年）では準絶滅危惧（NT）で、減っていると評価されています。IUCN の世界の区分は確かめられていません。"
    },
    "highlights": [
      "背から体の側面は黒く、腹は赤くなっています。腹の斑紋や尾の長さの割合は、地域によって大きく違います。",
      "夜に活発になります。本水槽でも、暗くなると泥の底をよく歩き回ります。",
      "ときどき水面へ泳ぎ上がって息を吸い、また底へ戻ります。"
    ]
  },
