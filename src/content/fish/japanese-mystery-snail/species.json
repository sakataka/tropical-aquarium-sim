  "catalog": {
    "scientificName": "Cipangopaludina japonica",
    "originRegionId": "japan",
    "originRegionName": "日本",
    "origin": "北海道、本州、四国、九州にすみます。",
    "temperament": "底の泥や水草に付く細かな藻類などを食べます。本水槽では、泥の底や枯れわらの上をゆっくり這い、ときどき立ち止まって底を削ります。",
    "movement": "本水槽では、殻を背負ったまま頭と足を伸び縮みさせて這い、触角を揺らします。叩かれると頭と足を殻に引っ込め、しばらくしてから這い出します。",
    "habitat": "池や沼、水路の、水の止まった所から流れのゆるい所の、泥の底や水草のある環境にすみます。福岡県では、環境のよい山あいのため池が主に残る場所になっています。本水槽では、田んぼの水路の泥の底をイメージしています。",
    "aliases": [
      "Heterogen japonica",
      "Japanese mystery snail"
    ]
  },
  "profile": {
    "taxonomy": {
      "order": "Architaenioglossa",
      "orderJa": "タニシ目",
      "family": "Viviparidae",
      "familyJa": "タニシ科"
    },
    "adultSizeCm": 6,
    "sizeNote": "殻長での値です（福岡県レッドデータブック2024）。画面では、殻長約6cm、触角を含めた幅約6.5cmで描いています。",
    "distribution": "北海道、本州、四国、九州。",
    "water": {
      "salinity": "freshwater"
    },
    "keeping": "home",
    "conservation": {
      "note": "環境省のレッドリストでは準絶滅危惧、福岡県レッドデータブック2024では絶滅危惧II類とされます（福岡県の資料による）。ため池や水路の改修、湿地などの開発、農薬の使用で数が減っています。"
    },
    "highlights": [
      "高い円錐形の螺塔をもち、螺層の周りが角張ります。小さな個体ほど角が目立ちます。",
      "雌雄が分かれていて、卵ではなく仔貝を産みます。",
      "タニシの仲間は、湿った泥の中で冬を越せるとされます。"
    ]
  },
