  "catalog": {
    "scientificName": "Protopterus aethiopicus",
    "originRegionId": "east-africa",
    "originRegionName": "東アフリカ",
    "origin": "東部・中部アフリカのナイル川、ビクトリア湖、タンガニーカ湖の水系などに分布し、コンゴ川にも記録があります。ケニアのバリンゴ湖の集団は、人の手で持ち込まれたものです。",
    "temperament": "成魚は貝類を中心に、小魚や昆虫も食べます。持ち込まれたバリンゴ湖の集団は、主に魚を食べていました。魚や無脊椎動物を食べるため、ほかの生き物と一緒に飼えるかは確かめられていません。",
    "movement": "円筒形の長い体で泳ぎ、糸のように細い胸びれと腹びれを持ちます。肺があり、しまね海洋館アクアスで飼われていた個体は、大きな口を水面に出して空気を吸っていました。",
    "habitat": "川や湖の岸辺、湿地、氾濫原に暮らし、若魚はパピルスの根が絡む所に見られます。干上がる氾濫原では、泥の中に粘液の繭をつくって乾眠することがあります。この水槽は、倒木の根と苔むした石のある泥底の沼を表しています。",
    "aliases": [
      "Marbled lungfish",
      "Leopard lungfish"
    ]
  },
  "profile": {
    "taxonomy": {
      "order": "Ceratodontiformes",
      "orderJa": "ケラトドゥス目",
      "family": "Protopteridae",
      "familyJa": "プロトプテルス科"
    },
    "adultSizeCm": 100,
    "sizeNote": "典型的な成魚の大きさは確認できず、ここでの値は展示用の目安です。動物園の解説では3〜6フィート（約0.9〜1.8m）とされ、最大の記録は全長200cm、体重17kgです。バリンゴ湖では、雌は全長70〜76cm、雄は82〜88cmで成熟していました。",
    "distribution": "東部・中部アフリカのナイル川、ビクトリア湖、タンガニーカ湖の水系と、コンゴ川の水系に分布します。",
