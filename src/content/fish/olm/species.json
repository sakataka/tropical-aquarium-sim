  "catalog": {
    "scientificName": "Proteus anguinus",
    "originRegionId": "europe",
    "originRegionName": "ヨーロッパ",
    "origin": "スロベニア・クロアチア・ボスニア・ヘルツェゴビナ・イタリアにまたがる、ディナル・カルスト地域の洞窟にすむ両生類です。英語では human fish とも呼ばれます。",
    "temperament": "野外の標識調査では、同じ個体が何年も数平方メートルの範囲で見つかり、ほとんど居場所を変えません。繁殖のときは、雄が縄張りを守ります。",
    "movement": "細長い体と短い脚で、洞窟の水底をゆっくり歩きます。前脚の指は3本、後脚の指は2本です。",
    "habitat": "カルスト洞窟の地下水の流れや地下湖にすみ、岩の下や裂け目に集まります。昆虫の幼虫や小型の甲殻類を食べます。本水槽では、光の届かない石灰岩の洞窟の川を再現しています。",
    "aliases": [
      "olm",
      "human fish"
    ]
  },
  "profile": {
    "taxonomy": {
      "order": "Caudata",
      "orderJa": "有尾目",
      "family": "Proteidae",
      "familyJa": "ホライモリ科"
    },
    "adultSizeCm": 24,
    "sizeNote": "動物園の解説では、全長23〜25cmとされます。画面では全長約24cmで描いています。",
    "distribution": "ヨーロッパ南東部のディナル・カルスト地域（スロベニア、クロアチア、ボスニア・ヘルツェゴビナ、イタリア）の洞窟に分布します。",
    "water": {
      "salinity": "freshwater"
    },
    "keeping": "publicAquarium",
    "conservation": {
      "note": "動物園の解説では IUCN の危急種（VU）とされていますが、2024年の評価での区分は確かめられていません。"
    },
    "highlights": [
      "成体になっても、頭の後ろの外鰓など幼生の特徴が残ります。",
      "体は淡いピンクがかった白色で、目は退化して皮膚に覆われています。",
      "研究では、寿命が100年を超えると予測されています（100歳の個体が実際に記録されたわけではありません）。"
    ]
  },
