  "catalog": {
    "scientificName": "Pipa pipa",
    "originRegionId": "south-america",
    "originRegionName": "南米",
    "origin": "アマゾン川の流域からギアナ地方、ペルー・エクアドル、トリニダード島にかけて分布します。",
    "temperament": "水底で枯れ葉のようにじっとして獲物を待ち伏せし、近づいた獲物へ後脚で突進して、口の中へ吸い込みながら前脚でかき込みます。飼育下では、雄はおもに夕方から夜に鳴きます。",
    "movement": "ほとんどの時間を水底でじっとして過ごします。泳ぐときは後脚を左右同時に伸ばして水を蹴ります。本水槽では、ときどき水面へ泳ぎ上がって息を吸い、また底へ戻ります。",
    "habitat": "熱帯雨林や浸水林の、泥の底の水域にすみます。本水槽では、雨季に水没したアマゾンの森の底で暮らします。",
    "aliases": [
      "Surinam toad",
      "Star-fingered frog",
      "ピパ",
      "ピパピパ"
    ]
  },
  "profile": {
    "taxonomy": {
      "order": "Anura",
      "orderJa": "無尾目",
      "family": "Pipidae",
      "familyJa": "ピパ科"
    },
    "adultSizeCm": 15,
    "sizeNote": "体長10〜20cmとされます（サンディエゴ動物園）。研究に使われた4匹の頭胴長は9.4〜14.3cmでした。画面では頭胴長約15cm、後脚を伸ばした長さを含めて約26cmで描いています。",
    "distribution": "アマゾン川の流域からギアナ地方、ペルー・エクアドル、トリニダード島に分布します。遺伝子の研究から、いくつかの種が混じっている可能性も指摘されています。",
    "water": {
      "salinity": "freshwater"
    },
    "keeping": "publicAquarium",
    "conservation": {
      "note": "IUCN レッドリストの区分は、今回の調査では確かめられていません。"
    },
    "highlights": [
      "体はとても平たく、頭は三角形で、前脚の指先が星形に分かれています。",
      "褐色からオリーブ色のまだら模様で、水底でじっとしていると枯れ葉のように見えます。",
      "卵は雌の背中の皮膚に埋まって育ち、オタマジャクシの時期を背中の中で過ごして、子ガエルの姿で出てきます。26℃前後で飼育した記録では、105〜145日かかりました。"
    ]
  },
